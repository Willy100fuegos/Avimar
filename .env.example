# ========================================================
# Variables de Entorno Opcionales - Avimar Web Portal
# ========================================================
# Copia este archivo a `.env.local` si deseas personalizar rutas o integraciones.
#
# BASE_PATH: Subdirectorio o ruta base pública para Vite (por defecto: "/")
# BASE_PATH=/
#
# IS_PREVIEW: Habilitar modo de previsualización (true/false)
# IS_PREVIEW=false
#
# PROJECT_ID: Identificador de proyecto para telemetry/analytics si aplica
# PROJECT_ID=
#
# VERSION_ID: Identificador de versión/build
# VERSION_ID=
#
# READDY_AI_DOMAIN: Dominio para integraciones de preview AI si aplica
# READDY_AI_DOMAIN=
